# ==========================================
# RUNGO ONE - ENVIRONMENT EXAMPLE
# ==========================================

# --- DATABASE ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rungo_one?schema=public"

# --- AUTHENTICATION ---
# Generate a secret using: npx auth secret
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- SYSTEM AUTOMATION (CRON) ---
# Used for /api/backup authentication. Match this in your cron task.
CRON_SECRET="replace-with-a-long-random-cron-secret"

# --- EXTERNAL INTEGRATIONS ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Production seed configuration
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="1234"
SEED_ADMIN_NAME="Demo Admin"
SEED_CREATE_SALES_USER="false"
SEED_SALES_USERNAME="sales"
SEED_SALES_PASSWORD="replace-with-a-temporary-secure-password"
SEED_SALES_NAME="Rungo Sales"
SEED_UPDATE_PASSWORDS="false"
SEED_DEMO_DATA="false"
SEED_COMPANY_NAME="Rungo One"
SEED_COMPANY_TIN="0042571273"
SEED_COMPANY_ADDRESS="Addis Ababa, Ethiopia"
SEED_COMPANY_PHONE="+251 911 000 000"
SEED_COMPANY_EMAIL=""
SEED_VAT_RATE="15"
SEED_CURRENCY_SYMBOL="ETB"
SEED_WEEKLY_BACKUP_ENABLED="false"
SEED_MAIN_STORE_CODE="MAIN-STORE"
SEED_MAIN_STORE_NAME="Main Store"
SEED_MAIN_STORE_CITY="Addis Ababa"
SEED_MAIN_SHOP_CODE="MAIN-SHOP"
SEED_MAIN_SHOP_NAME="Main Shop"
SEED_MAIN_SHOP_CITY="Addis Ababa"

# --- PRODUCTION RUNTIME SETTINGS ---
# BETTER_AUTH_ALLOWED_HOSTS="your-domain.com"
# PG_POOL_MAX="20"
# PG_IDLE_TIMEOUT_MS="30000"
# PG_CONNECTION_TIMEOUT_MS="2000"
# BACKUP_DIR="./public/backups"
